# Vorlage für die lokale Entwicklung. Kopieren nach `.env` und Werte
# anpassen. `.env` selbst ist in .gitignore und wird nie committet
# (ARCHITECTURE.md §11.1 — Konfiguration ausschließlich über
# Umgebungsvariablen, keine Secrets im Repository).
#
# In Docker/Produktion werden diese Variablen als echte Umgebungs-
# variablen gesetzt, keine .env-Datei nötig.

# Beliebiger langer Zufallsstring, z. B.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=changeme-nur-fuer-lokale-entwicklung

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Lokale Entwicklung ohne Docker: entweder eine lokal laufende
# PostgreSQL-Instanz, oder `docker compose up db` sobald Task 0.3
# steht.
DATABASE_URL=postgres://magic_personality:magic_personality@localhost:5432/magic_personality
