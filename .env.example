# Vorlage für die lokale Entwicklung. Kopieren nach `.env` und Werte
# anpassen. `.env` selbst ist in .gitignore und wird nie committet
# (ARCHITECTURE.md §11.1 — Konfiguration ausschließlich über
# Umgebungsvariablen, keine Secrets im Repository).
#
# In Docker/Produktion werden diese Variablen als echte Umgebungs-
# variablen gesetzt, keine .env-Datei nötig.

# Beliebiger langer Zufallsstring, z. B.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=changeme-nur-fuer-lokale-entwicklung

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Lokale Entwicklung ohne Docker (z. B. `manage.py runserver` gegen
# eine lokal laufende PostgreSQL-Instanz oder `docker compose up db`):
# DATABASE_URL zeigt auf "localhost", weil der Port aus compose.yaml
# auf den Host gemappt ist.
#
# Für den "web"-Container selbst (docker compose up) überschreibt
# compose.yaml DATABASE_URL automatisch auf den Compose-internen
# Hostnamen "db" — diese Zeile hier wird dafür nicht verwendet.
DATABASE_URL=postgres://magic_personality:magic_personality@localhost:5432/magic_personality

# Von compose.yaml gelesen, um den "db"-Container und die obige
# DATABASE_URL konsistent zu halten. Ändern nur zusammen mit
# DATABASE_URL.
POSTGRES_USER=magic_personality
POSTGRES_PASSWORD=magic_personality
POSTGRES_DB=magic_personality
